    accounts_user {
        integer id PK
        varchar username UK
        varchar password
        varchar email
        varchar first_name
        varchar last_name
        varchar gender
        date birth_date
        integer age
        integer weekly_reading_time
        integer yearly_reading_count
        varchar profile_image
        datetime last_login
        datetime date_joined
        boolean is_active
        boolean is_staff
        boolean is_superuser
    }

    books_book {
        integer id PK
        varchar title
        text description
        real review_score "0~10점"
        varchar author
        bigint user_id FK
        bigint category_id FK "NULL 허용"
        text author_info
        json author_works
        varchar author_image_url
        varchar author_source_url
        varchar author_ai_status
    }

    books_thread {
        integer id PK
        bigint book_id FK
        bigint user_id FK
        varchar title
        text content
        date reading_date
        datetime created_at
        datetime updated_at
        varchar cover_image
        json cover_keywords
        text cover_prompt
        varchar cover_ai_status
    }

    books_comment {
        integer id PK
        bigint thread_id FK
        bigint user_id FK
        text content
        datetime created_at
    }

    books_category {
        integer id PK
        varchar name UK
    }

    accounts_user_followings {
        integer id PK
        bigint from_user_id FK "팔로우하는 사용자"
        bigint to_user_id FK "팔로우받는 사용자"
    }

    books_thread_likes {
        integer id PK
        bigint thread_id FK
        bigint user_id FK
    }

    accounts_user_preferred_categories {
        integer id PK
        bigint user_id FK
        bigint category_id FK
    }
