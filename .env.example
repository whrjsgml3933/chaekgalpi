# Local development: leave blank for an ephemeral key, or generate a stable key.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# AI is optional. Use either GMS_API_KEY or OPENAI_API_KEY, not a public repository secret.
GMS_API_KEY=
OPENAI_API_KEY=
AI_ENABLED=true
AI_IMAGE_MODEL=gpt-image-2
